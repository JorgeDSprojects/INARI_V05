POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboardpassword
POSTGRES_DB=uns_dashboard
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://dashboard:dashboardpassword@uns_dashboard_postgres:5432/uns_dashboard
EMQX_HOST=emqx
EMQX_PORT=1883
EMQX_API_PORT=18083
EMQX_API_USERNAME=
EMQX_API_PASSWORD=
REDIS_HOST=uns_dashboard_redis
REDIS_PORT=6379
STREAM_MAXLEN=1000
HISTORIAN_DATABASE_URL=postgresql+asyncpg://historian:historianpassword@uns_historian_postgres:5432/uns_historian
BACKEND_PORT=8001
FRONTEND_PORT=3002
VITE_API_BASE_URL=http://localhost:8001
BRIDGE_MQTT_CLIENT_ID=uns-dashboard-bridge
UNS_MANAGER_NETWORK_NAME=uns_manager_uns_net

# Chat agent: MCP server (read-only access to UNS_SILVER) and LLM provider.
# MCP_API_KEY must match UNS_MCP's configured MCP_API_KEY.
# LLM_PROVIDER_TYPE=none disables the chat feature entirely; set to
# openai_compatible to use an OpenAI-compatible endpoint (e.g. Ollama).
MCP_SERVER_URL=http://uns_mcp_server:8000/mcp
MCP_API_KEY=
LLM_PROVIDER_TYPE=none
LLM_BASE_URL=http://uns_ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:14b-instruct
