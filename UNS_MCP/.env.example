# Points at UNS_SILVER's Postgres, using the read-only silver_reader role
# (not the full 'silver' app credentials -- see UNS_SILVER Task 1).
# Password here must match SILVER_READER_PASSWORD in UNS_SILVER/.env.
SILVER_DATABASE_URL=postgresql://silver_reader:silverreaderpassword@uns_silver_postgres:5432/uns_silver

# Shared API key required on every HTTP request. Any real deployment MUST
# set a real key here: the server refuses to start while this is left at
# the default, unless MCP_ALLOW_DEFAULT_KEY=true.
MCP_API_KEY=changeme-local-dev-key

# Escape hatch for the default-key guard above. Leave this unset (it
# defaults to false) for any real deployment -- UNS_MCP/docker-compose.yml
# sets it to true by default so `docker compose up` works out of the box
# for local testing, which is the only case it is meant for.
# MCP_ALLOW_DEFAULT_KEY=true

# DNS-rebinding protection for the streamable-http transport. These must be
# set explicitly: with no allow-list the MCP SDK permits loopback Host
# headers only and answers every container-to-container call with HTTP 421.
# Comma-separated; a trailing ":*" wildcards the port. Add the DNS name any
# other stack reaches this server by (e.g. its container name).
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,uns_mcp_server:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# HTTP transport binding (inside the container)
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Host port mapping (outside the container)
MCP_HTTP_PORT=8095

# Docker network shared with UNS_MANAGER (same variable every other stack uses)
UNS_MANAGER_NETWORK_NAME=uns_manager_uns_net
