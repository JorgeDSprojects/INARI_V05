# Points at UNS_SILVER's Postgres, using the read-only silver_reader role
# (not the full 'silver' app credentials -- see UNS_SILVER Task 1).
# Password here must match SILVER_READER_PASSWORD in UNS_SILVER/.env.
SILVER_DATABASE_URL=postgresql://silver_reader:silverreaderpassword@uns_silver_postgres:5432/uns_silver

# Shared API key required on every HTTP request. Change this for any
# non-local deployment.
MCP_API_KEY=changeme-local-dev-key

# HTTP transport binding (inside the container)
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Host port mapping (outside the container)
MCP_HTTP_PORT=8090

# Docker network shared with UNS_MANAGER (same variable every other stack uses)
UNS_MANAGER_NETWORK_NAME=uns_manager_uns_net
